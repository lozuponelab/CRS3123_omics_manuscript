from snake_utils.snake_functions import comb_filepaths, make_fp_dict


RAW_SEQ_IN =  config['raw_seq_in']
METADATA = pd.read_csv(config['metadata_file'])
SAMPLE_LIST = METADATA['Sample'].tolist()

## user input genome index files and the name of the index 
FILTER_FASTA = config['filter_to_fasta']

## to move wanted genome index files for star, rsem, and picard into the pipeline's working directory so bind points dont break 
REF_DIR = "user_reference_files"
NEW_FASTA_PATH= pj(REF_DIR, basename(FILTER_FASTA))

## humann reference indices 
METAPHLAN_DB = config['metaphlan_db']
METAPHLAN_INDEX_NAME = config['metaphlan_index_name']
CHOCOPHLAN_DB = config['chocophlan_db']
UNIREF_DB = config['uniref_db']
UTILITY_MAPPING_DB = config['utility_mapping_db']

sample_fp_dict = make_fp_dict(metadata_df=METADATA,
                              dataset_dir=RAW_SEQ_IN)


## conda environment
